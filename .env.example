# Copy this file to `.env` at the repository root. It is the single place for
# operator-adjustable runtime values. `.env` is gitignored; never commit tokens.
# Command-line parameters and an already exported process environment override it.
# Device inventory stays in `dpi-network.yaml` because it is structured data.
#
# Core paths and listeners. Keep loopback hosts unless you intentionally expose
# the service through an authenticated reverse proxy.
# DPI_HOME=%USERPROFILE%\.dpi
# DPI_WORKSPACE_ROOT=%USERPROFILE%\dpi-work
# DPI_NETWORK_FILE=D:\path\to\durable-pi\dpi-network.yaml
# DPI_DEVICE_NAME=my-workstation
# DPI_NETWORK_DEVICE_ID=local
# Backend provider(s): faux, openrouter, openai, deepseek,
# comma-separated combinations (e.g. deepseek,openai), or local (deepseek+openai).
# Antigravity is registered separately as a protected, user-facing T3 Provider.
# It is never used by the Durable scheduler, worker fallback chain, or another Agent.
# DPI_PROVIDER=faux
# DPI_HOST=127.0.0.1
# DPI_PORT=4780
# DPI_HUB_HOST=127.0.0.1
# DPI_HUB_PORT=4781

# T3 and cross-device routing. SSH aliases belong in ~/.ssh/config; credentials
# and passwords never belong here. Comma-separate peers, or leave blank to
# disable automatic peer linking.
# DPI_T3_LOCAL_PORT=3773
# DPI_T3_PEERS=durable-linux,durable-macos
# DPI_T3_PEER_ACCESS=auto
# DPI_TUNNEL_REMOTE_SSH_PORT=22022
# DPI_TUNNEL_REMOTE_T3_PORT=13773
# DPI_NO_PROXY=127.0.0.1,localhost,.ts.net
# JSON mapping used only to generate Codex routing guidance. Replace these
# examples with the roots exposed by your own read-only data-source catalog.
# DPI_DATA_ROOT_MAPPINGS_JSON=[{"root":"C:\\Work","source":"windows-workspace"},{"root":"/home/user","source":"linux-home"},{"root":"/Users/user","source":"macos-home"}]

# Background monitor intervals. Defaults are intentionally quiet while idle.
# DPI_T3_WAITING_INTERVAL_MS=10000
# DPI_T3_PROJECT_INTERVAL_MS=30000
# DPI_T3_ENVIRONMENT_INTERVAL_MS=10000

# `just net up <id>` copies the keys listed under `env_keys` in
# dpi-network.yaml into each device's ~/.dpi/backend.env.
# Legacy standalone Pi network only. The T3 + Codex path reuses the current Codex login and does not need this key.
# OPENROUTER_API_KEY=

# Optional Local Codex Coordinator safety limits. Defaults: 8 coordination rounds,
# 12 newly delegated tasks per Coordinator turn, and 64 unfinished tasks per project.
# DPI_MAX_COORDINATION_DEPTH=8
# DPI_MAX_DELEGATED_TASKS_PER_TURN=12
# DPI_MAX_ACTIVE_PROJECT_TASKS=64
# DPI_MAX_GLOBAL_RUNNING=4
# DPI_MAX_PROJECT_RUNNING=2
# DPI_MAX_WORKER_RUNNING=4
# Context budget: 32K conservative first-turn fallback, 128K platform cap, with
# at least 4K each reserved for output and tool results. Runtime observations may
# expand later turns up to the cap; proportional reserves can grow beyond 4K.
# DPI_FALLBACK_CONTEXT_TOKENS=32768
# DPI_MAX_CONTEXT_TOKENS=131072
# DPI_RESERVED_OUTPUT_TOKENS=4096
# DPI_RESERVED_TOOL_TOKENS=4096
# Persistent Provider circuit breaker. Three consecutive transient failures open
# the circuit for 30s; each failed half-open probe doubles it up to 30 minutes.
# DPI_PROVIDER_FAILURE_THRESHOLD=3
# DPI_PROVIDER_BASE_OPEN_MS=30000
# DPI_PROVIDER_PROBE_LEASE_MS=60000

# Consistent SQLite + Artifact snapshots are taken while the Hub stays online.
# Default: every 6 hours; accepted range: 1 minute through 7 days.
# DPI_BACKUP_INTERVAL_MS=21600000

# ACTIVE Artifacts whose expiresAt has passed are marked EXPIRED automatically.
# Their files remain recoverable until the separate retention purge runs.
# Default: every minute; accepted range: 10 seconds through 24 hours.
# DPI_ARTIFACT_EXPIRY_INTERVAL_MS=60000

# ACTIVE project memories with expiresAt are invalidated automatically while
# preserving immutable revisions. Same accepted range as Artifact expiry.
# DPI_MEMORY_EXPIRY_INTERVAL_MS=60000

# T3 runtime. The Windows launcher defaults this to 1 for write-capable,
# non-Coordinator Agents; set 0 explicitly to disable it.
# DPI_T3_RUNTIME=1
# Dedicated T3 Codex provider used by Coder/Tester workers. Its launch arguments must
# disable the durable-pi MCP so a worker sharing the project cwd cannot inherit the
# Coordinator's identity or coordination tools.
# DPI_T3_WORKER_PROVIDER_INSTANCE=codex
# Read-only T3 Provider for Coordinator result handling. It keeps durable-pi but
# disables unrelated local side-effect MCPs.
# DPI_T3_COORDINATOR_PROVIDER_INSTANCE=codex_durable_coordinator
# Shared defaults for Coordinators, Durable workers, and spawned specialists.
# DPI_COORDINATOR_MODEL=gpt-5.6-sol
# DPI_CODEX_REASONING_EFFORT=medium
# DPI_CODEX_SERVICE_TIER=fast
# DPI_CODEX_SUBAGENT_MODEL=gpt-5.6-sol
# DPI_CODEX_SUBAGENT_REASONING_EFFORT=medium

# Optional protected Google Antigravity T3 Provider (Google account OAuth ONLY) and DeepSeek Harness.
# Google Gemini NEVER uses GEMINI_API_KEY. Keep the CLI account in a dedicated GEMINI_HOME so
# Desktop Antigravity login/logout cannot alter the CLI credential store. All Gemini API-key env
# variables are stripped before launching Antigravity.
# DPI_GEMINI_HOME=C:\Users\you\.gemini
# Relative directory below DPI_GEMINI_HOME. On Windows this can be a junction whose physical
# target lives outside the Desktop Antigravity state root.
# DPI_ANTIGRAVITY_APP_DATA_DIR=antigravity-cli-isolated
# DPI_GEMINI_DEFAULT_MODEL=gemini-4-neon
# DPI_GEMINI_MODELS=
# Optional custom path to Antigravity executable (auto-detected on Windows/macOS/POSIX).
# DPI_ANTIGRAVITY_CLI_BIN=
# T3 provider binary/wrapper. On Windows point this at the isolated agy.cmd
# wrapper so T3 and the standalone CLI share the CLI profile without touching
# the Antigravity desktop app account. On Linux/macOS use ~/.local/bin/agy.
# DPI_ANTIGRAVITY_T3_BINARY=
# Deprecated compatibility variable. Durable never launches Antigravity as a worker or fallback.
# The `antigravity` T3 Provider remains available for a user to open directly; its official runtime
# owns any native child Agents and keeps every child inside the Antigravity model domain.
# DPI_T3_GEMINI_WORKER_PROVIDER_INSTANCE=
#
# DeepSeek uses official DEEPSEEK_API_KEY here or `~/.pi/agent/auth.json` via `pi auth login deepseek`.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DPI_DEEPSEEK_DEFAULT_MODEL=deepseek-chat
# DPI_DEEPSEEK_MODELS=
# Dedicated T3 Pi provider instance for write-capable DeepSeek workers (local or verified remote).
# Set DPI_T3_PI_RUNTIME=1 to force registration even when credentials live only in ~/.pi/agent/auth.json.
# DPI_T3_PI_RUNTIME=1
# DPI_T3_PI_WORKER_PROVIDER_INSTANCE=pi_durable_worker
# Optional custom local Pi CLI path (defaults to ~/.pi/agent/bin/pi-launcher.js on Windows or `pi` on POSIX).
# DPI_PI_COMMAND=
# Optional role-to-model defaults for local non-Coordinator workers (empty keeps Codex default for all roles).
# Example: {"reviewer":"deepseek/deepseek-reasoner","researcher":"google/gemini-2.5-pro"}
# DPI_ROLE_MODEL_MAP_JSON={}

# Optional custom Codex app-server launcher. Normally leave unset so the platform reuses the
# installed `codex` command and its current login. Arguments must be a JSON array of strings.
# DPI_CODEX_APP_SERVER_COMMAND=C:\\path\\to\\custom-launcher.exe
# DPI_CODEX_APP_SERVER_ARGS_JSON=["app-server","--stdio"]
# Global Codex MCP servers disabled inside isolated platform workers. Project
# coordination is injected directly and does not need the recursive durable-pi MCP.
# DPI_CODEX_DISABLED_MCP_SERVERS=anode,durable-pi,rea,reaper

# Optional: call Jev through TypeSafe directly instead of OpenRouter (jev-damage-control and
# the proactive demo). Add it to `env_keys` in dpi-network.yaml to send it to your devices.
# TYPESAFE_API_KEY=

# Only for apps/proactive-dpi-demo (text-to-speech announcements). Without it the demo runs silently.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=56bWURjYFHyYyVf490Dp   # any voice in your ElevenLabs account
# ELEVENLABS_MODEL=eleven_v4_turbo
# DPI_READY_SPEECH="Engineer, your Durable Agent Red Team found a production issue, and found the fix. It's waiting on your review."
# DPI_OPENED_SPEECH="Engineer, heads up. Jev flagged a production issue in {service}. A durable agent is investigating."
